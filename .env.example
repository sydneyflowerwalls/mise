# Copy this file to `.env` (NOT .env.local).
#
# Next.js reads both, but the Prisma CLI only reads `.env` — so `npm run
# db:push` and `npm run db:seed` cannot see variables placed in `.env.local`.
# One `.env` file serves both. It is gitignored.
#
# ---------------------------------------------------------------------------
# Claude
# ---------------------------------------------------------------------------
# NOTHING is needed here while running on the owner's PC. The Agent SDK picks
# up the existing Claude Code login at ~/.claude/.credentials.json.
#
# On a remote host later: run `claude setup-token` and set:
# CLAUDE_CODE_OAUTH_TOKEN=
#
# DO NOT ADD ANTHROPIC_API_KEY HERE. Not even blank. An empty value becomes ""
# in process.env, shadows the OAuth credentials, and silently switches every
# call to metered billing. See §2 of the integration brief.
# ---------------------------------------------------------------------------

# Supabase pooled connection (app queries)
DATABASE_URL=
# Supabase direct connection (migrations only)
DIRECT_URL=

# Auth
AUTH_SECRET=
# Must be the Tailscale hostname, NOT localhost, or callbacks fail confusingly.
AUTH_URL=https://your-machine.tailnet-name.ts.net

# Household size — default servings for a new meal slot
NEXT_PUBLIC_HOUSEHOLD_SIZE=2
