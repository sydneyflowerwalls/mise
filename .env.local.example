# Local Postgres, matching docker-compose.yml.
# Copy the two lines below into a file named `.env` in the project root.
#
# Both URLs are identical here. They differ only on Supabase, where the app
# goes through a connection pooler but migrations cannot.

DATABASE_URL="postgresql://mise:mise@localhost:5432/mise"
DIRECT_URL="postgresql://mise:mise@localhost:5432/mise"
